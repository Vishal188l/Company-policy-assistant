# Copy this file to .env and fill in your own values. Never upload .env to GitHub.
GEMINI_API_KEY=paste-your-gemini-key-here
SLACK_BOT_TOKEN=xoxb-paste-bot-token-here
SLACK_APP_TOKEN=xapp-paste-app-token-here

# Optional
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
RUN_DELAY_SECONDS=4
